# Copy to backend/.env and fill in. Never commit the real .env.

# --- Google OAuth (from Google Cloud Console -> Credentials -> OAuth client, type "Web") ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Session ---
SESSION_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false            # true in AWS (HTTPS)

# --- CORS (only if the UI is served from a different origin in dev) ---
FRONTEND_ORIGIN=

# --- OpenAI (the agent composes replies; leave key blank to use the stub fallback) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Style store ---
STYLE_STORE_DIR=./.data/style_store
SEED_DAYS=30
SEED_MAX_PAIRS=300
COLD_START_MIN_PAIRS=30
STYLE_MODE=retrieval

# --- Agent ---
MAX_AGENT_STEPS=6
CHECKPOINTER_DB=./.data/checkpoints.sqlite
