# Google OAuth (backend only - never exposed to the browser)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Signs the draftagent_session cookie
SESSION_SECRET=change-me

# Only needed when the UI is served from a different origin (vite dev on :5173)
FRONTEND_ORIGIN=http://localhost:5173

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Style store
STYLE_STORE_DIR=./style_store_data
SEED_DAYS=30
SEED_MAX_PAIRS=300
COLD_START_MIN_PAIRS=30
STYLE_MODE=retrieval

# Agent
MAX_AGENT_STEPS=6

# Where FastAPI looks for the built UI (npm run build output)
WEB_DIST_DIR=../web/dist
