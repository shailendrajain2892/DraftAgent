# true  -> the UI talks to fixture JSON in web/mocks/ (no backend needed)
# false -> the UI talks to the real FastAPI backend
VITE_USE_MOCKS=true

# Which mock scenario to boot with. Override at runtime with ?mock=<name>.
# default | empty | unauthenticated | auth-expired | upstream-error | slow-run | style-failed
VITE_MOCK_SCENARIO=default

# Leave empty when FastAPI serves the built UI (same origin). In dev the Vite
# proxy in vite.config.js handles it, so this normally stays empty.
VITE_API_BASE_URL=
